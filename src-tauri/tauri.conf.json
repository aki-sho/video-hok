{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video HOK",
  "version": "1.0.0",
  "identifier": "local.video-hok.player",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "aki-sho",
    "shortDescription": "Simple media player for Windows",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ],
        "startMenuFolder": "Video HOK"
      }
    }
  }
}
